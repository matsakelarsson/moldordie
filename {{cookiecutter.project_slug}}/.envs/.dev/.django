# General
# ------------------------------------------------------------------------------
# DJANGO_READ_DOT_ENV_FILE=True
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=!!!SET DJANGO_SECRET_KEY!!!
DJANGO_ADMIN_URL=!!!SET DJANGO_ADMIN_URL!!!/
{%- if cookiecutter.observability == 'prometheus' %}
# The last name is the Compose service, which a scrape inside the network dials
DJANGO_ALLOWED_HOSTS=dev.{{ cookiecutter.domain_name }},django
{%- else %}
DJANGO_ALLOWED_HOSTS=dev.{{ cookiecutter.domain_name }}
{%- endif %}

# Security
# ------------------------------------------------------------------------------
# TIP: better off using DNS, however, redirect is OK too
DJANGO_SECURE_SSL_REDIRECT=False
# Content Security Policy: send violation reports here and/or only report violations without blocking
# DJANGO_CSP_REPORT_URI=
# DJANGO_CSP_REPORT_ONLY=False

# Email
# ------------------------------------------------------------------------------
DJANGO_SERVER_EMAIL=
{% if cookiecutter.mail_service == 'Mailgun' %}
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
{% endif %}
{% if cookiecutter.cloud_provider == 'AWS' %}
# AWS
# ------------------------------------------------------------------------------
DJANGO_AWS_ACCESS_KEY_ID=
DJANGO_AWS_SECRET_ACCESS_KEY=
DJANGO_AWS_STORAGE_BUCKET_NAME=
{% endif %}
# django-allauth
# ------------------------------------------------------------------------------
DJANGO_ACCOUNT_ALLOW_REGISTRATION=True
{%- if cookiecutter.rest_api == 'Django Ninja' and cookiecutter.identity_provider != 'none' %}
# The single-page application: the key its tokens are signed with, the origins it is
# served from (comma-separated) and where it is
DJANGO_HEADLESS_JWT_PRIVATE_KEY=!!!SET DJANGO_HEADLESS_JWT_PRIVATE_KEY!!!
DJANGO_FRONTEND_ORIGINS=
DJANGO_FRONTEND_URL=
{%- if cookiecutter.identity_provider == 'entra' %}
# Calling services: the API's app registration, and the app role a service must hold
ENTRA_API_CLIENT_ID=
# ENTRA_SERVICE_ROLE=Service.Access
{%- else %}
# Calling services: the audience their identity tokens name
# GOOGLE_SERVICE_AUDIENCE=https://dev.{{ cookiecutter.domain_name }}
{%- endif %}
{%- endif %}
{%- if cookiecutter.identity_provider == 'entra' %}
# Sign-in through Microsoft Entra ID: the tenant and the login app registration
ENTRA_TENANT_ID=
ENTRA_LOGIN_CLIENT_ID=
ENTRA_LOGIN_CLIENT_SECRET=
{%- elif cookiecutter.identity_provider == 'google' %}
# Sign-in through Google: the web client
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
{%- endif %}

# Gunicorn
# ------------------------------------------------------------------------------
WEB_CONCURRENCY=4
{% if cookiecutter.use_sentry == 'y' %}
# Sentry
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
{% endif %}{% if cookiecutter.observability == 'prometheus' %}
# Metrics
# ------------------------------------------------------------------------------
# The credential a scrape presents to /metrics. No token, no metrics.
DJANGO_METRICS_TOKEN=!!!SET DJANGO_METRICS_TOKEN!!!
{% endif %}

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
{% if cookiecutter.use_celery == 'y' %}
# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=!!!SET CELERY_FLOWER_USER!!!
CELERY_FLOWER_PASSWORD=!!!SET CELERY_FLOWER_PASSWORD!!!
{% endif %}
