# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython
{%- if cookiecutter.identity_provider == 'entra' %}

# django-allauth
# ------------------------------------------------------------------------------
# Sign-in through Microsoft Entra ID: the tenant and the login app registration
ENTRA_TENANT_ID=
ENTRA_LOGIN_CLIENT_ID=
ENTRA_LOGIN_CLIENT_SECRET=
{%- elif cookiecutter.identity_provider == 'google' %}

# django-allauth
# ------------------------------------------------------------------------------
# Sign-in through Google: the web client
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
{%- endif %}

{%- if cookiecutter.use_celery == 'y' %}
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=!!!SET CELERY_FLOWER_USER!!!
CELERY_FLOWER_PASSWORD=!!!SET CELERY_FLOWER_PASSWORD!!!
{%- endif %}
{%- if cookiecutter.observability == 'prometheus' %}

# Metrics
# ------------------------------------------------------------------------------
# The credential the local Prometheus presents; a development value, not a secret,
# so compose/local/prometheus/prometheus.yml can name it. Deployments draw their own.
DJANGO_METRICS_TOKEN=development-metrics-token
{%- endif %}
