# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython
{%- if cookiecutter.identity_provider == 'entra' %}

# django-allauth
# ------------------------------------------------------------------------------
# Sign-in through Microsoft Entra ID: the tenant and the login app registration
ENTRA_TENANT_ID=
ENTRA_LOGIN_CLIENT_ID=
ENTRA_LOGIN_CLIENT_SECRET=
{%- elif cookiecutter.identity_provider == 'google' %}

# django-allauth
# ------------------------------------------------------------------------------
# Sign-in through Google: the web client
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
{%- endif %}
{%- if cookiecutter.service_tokens %}

# Calling services
# ------------------------------------------------------------------------------
{%- if cookiecutter.identity_provider == 'entra' %}
# The registration a service's token must name as its audience, and the app role it
# must hold; the checks report the registration empty until a service calls this checkout
ENTRA_API_CLIENT_ID=
# ENTRA_SERVICE_ROLE=Service.Access
{%- else %}
# The audience their identity tokens name
# GOOGLE_SERVICE_AUDIENCE=https://{{ cookiecutter.domain_name }}
{%- endif %}
{%- endif %}

{%- if cookiecutter.use_celery == 'y' %}
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=!!!SET CELERY_FLOWER_USER!!!
CELERY_FLOWER_PASSWORD=!!!SET CELERY_FLOWER_PASSWORD!!!
{%- endif %}
{%- if cookiecutter.observability == 'prometheus' %}

# Metrics
# ------------------------------------------------------------------------------
# The credential the local Prometheus presents; a development value, not a secret,
# so {% if cookiecutter.use_docker == 'y' %}compose/local/prometheus/prometheus.yml{% else %}the scraper you run beside it{% endif %} can name it. Deployments draw their own.
DJANGO_METRICS_TOKEN=development-metrics-token
{%- endif %}
{%- if cookiecutter.observability == 'opentelemetry' %}

# Telemetry
# ------------------------------------------------------------------------------
# The collector of this Compose file, which prints what arrives. A deployment names
# one of its own, and each names a different deployment.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_DEPLOYMENT_ENVIRONMENT=local
{%- endif %}
